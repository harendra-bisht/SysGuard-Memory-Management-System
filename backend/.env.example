# Copy this file to .env and adjust as needed.
# The app reads these via os.environ — if you want them auto-loaded,
# install python-dotenv and add `from dotenv import load_dotenv; load_dotenv()`
# near the top of app.py, or just export them in your shell before running.

PORT=5000
HOST=0.0.0.0
DEBUG=false

# Comma-separated list of origins allowed to call this API (your Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "Full scale" combined up+down Mbps used to convert network throughput
# into the 0-100% figure shown on the dashboard's network gauge.
NET_MAX_MBPS=100
